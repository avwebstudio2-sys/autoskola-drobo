# Nije obavezno: Firebase konfiguracija je već u src/lib/firebase.js.
# Ako želite drugi Firebase projekat, kopirajte ovaj fajl u .env i upišite njegove podatke
# (Firebase konzola -> Project settings -> Your apps -> Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
